# 감시할 무신사 상품
PRODUCT_URL=https://www.musinsa.com/products/6990137

# 확인 간격(초). 60초 미만은 허용하지 않습니다. 권장: 180~300초
INTERVAL_SECONDS=300

# 첫 실행부터 이미 재고가 있으면 알림을 보낼지 여부
# false: 첫 실행은 기준 상태만 저장(권장)
NOTIFY_ON_FIRST_AVAILABLE=false

# 상태 저장 파일. Docker에서는 /data/state.json 권장
STATE_FILE=./state.json

# 페이지 로딩 제한 시간(ms)
PAGE_TIMEOUT_MS=45000

# 브라우저 화면 표시 여부. 서버/Docker에서는 true
HEADLESS=true

# 상품 옵션을 펼치기 위해 '구매하기' 버튼을 눌러볼지 여부
# 장바구니/결제를 진행하지 않고 옵션 창만 엽니다.
OPEN_OPTION_PANEL=true

# 알림 방식 1: Telegram
# 발급: Telegram @BotFather에서 봇 생성 후 토큰 받기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 알림 방식 2: Discord 또는 Slack Incoming Webhook
WEBHOOK_URL=
WEBHOOK_KIND=discord

# 알림 설정이 하나도 없으면 콘솔에만 출력합니다.
